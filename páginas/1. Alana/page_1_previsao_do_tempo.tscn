theme_override_font_sizes/bold_italics_font_size = 24
theme_override_font_sizes/italics_font_size = 20
theme_override_font_sizes/mono_font_size = 20
bbcode_enabled = true
text = "	Todo mundo confere a previsão antes de sair. Se vai chover leva guarda-chuva, se vai fazer frio leva roupa quente. Antigamente se olhava pro céu pra prever, mas o tempo muda muito rápido, então precisa de especialista.
	Meteorologia é a ciência que estuda a atmosfera e faz previsões com base em dados. As previsões são feitas em centros de monitoramento como o INMET e o INPE no Brasil.
	Os dados vêm de milhares de estações meteorológicas com instrumentos como termômetro, anemômetro e pluviômetro, além de satélites, radares e radiossondas. Como usam modelos físicos e estatísticos, a previsão indica probabilidades, não certezas."
fit_content = true
visible_characters = 0
visible_ratio = 0.0

