theme_override_font_sizes/mono_font_size = 20
bbcode_enabled = true
text = "	A unidade relativa do ar indica quanto vapor-d'água existe no ar em determinado momento e temperatura. Ou seja, demonstra se o ar está mais seco ou mais úmido, dependendo da quantidade de água presente na atmosfera.
	A umidade é medida pelo higrômetro, instrumento que expressa em porcentagem os valores de umidade do ar.

- Valores abaixo de 30%: Ar seco.
- Entre 40% e 70%: Adequados.
- Acima de 60%: O ar é classificado como úmido.

	Ambos valores de umidade muito baixos ou muito elevados podem favorecer o desconforto respiratório e agravar ou causar problemas respiratórios."
fit_content = true

